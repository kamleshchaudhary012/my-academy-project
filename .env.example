# ==============================================================================
# DAANGIVES BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env for local development or configure in deployment environment.
# NEVER commit real production secrets, passwords, or API keys to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DJANGO & SECURITY SETTINGS
# ------------------------------------------------------------------------------
# In production, generate a secure random 50+ character key:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=YOUR_DJANGO_SECRET_KEY_HERE

# Set DEBUG=False in production. Set DEBUG=True for local development only.
DEBUG=True

# Comma-separated list of allowed hostnames/domain names
ALLOWED_HOSTS=localhost,127.0.0.1,api.daangives.org

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL Recommended)
# ------------------------------------------------------------------------------
DB_ENGINE=django.db.backends.postgresql
DB_NAME=daangives_db
DB_USER=daan_user
DB_PASSWORD=YOUR_DATABASE_PASSWORD
DB_HOST=127.0.0.1
DB_PORT=5432

# ------------------------------------------------------------------------------
# 3. CORS & CSRF TRUSTED ORIGINS
# ------------------------------------------------------------------------------
# Comma-separated list of origins authorized for cross-origin API requests
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://daangives.org

# Comma-separated list of trusted origins for CSRF protection
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://daangives.org

# ------------------------------------------------------------------------------
# 4. RAZORPAY PAYMENT GATEWAY SETTINGS
# ------------------------------------------------------------------------------
# Sandbox test keys for development: rzp_test_*
# Production live keys: rzp_live_*
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL & SMTP SETTINGS
# ------------------------------------------------------------------------------
# Development default: console backend (prints emails to terminal)
# Production backend: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Production SMTP host details (AWS SES, SendGrid, Mailgun, or standard SMTP)
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=YOUR_SMTP_USERNAME
EMAIL_HOST_PASSWORD=YOUR_SMTP_PASSWORD
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=DaanGives Platform <noreply@daangives.org>

# ------------------------------------------------------------------------------
# 6. PRODUCTION HTTPS & COOKIE SECURITY SETTINGS
# ------------------------------------------------------------------------------
# Enable these in production when deploying behind HTTPS:
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_REFERRER_POLICY=same-origin
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
